# Runtime artifacts & captured telemetry — NEVER commit (esp. in a shared repo:
# data/ holds the full local capture DB of every session). Blanket-ignore the
# whole directory; the specific entries below are kept for clarity.
data/
data/prompts.db
data/prompts.db-wal
data/prompts.db-shm
data/backups/
data/reruns/
data/*.log
data/*.log.*
data/.migrations.lock
data/.lock
data/*.html
data/insights.json
data/insights.json.tmp

# Python
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.eggs/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local environment overrides
.env
.env.*
!.env.example

# uv / pip
.python-version

# AI / model artifacts (v3)
data/models/
data/push.log
data/vapid_private.pem
data/vapid_public.pem

# Editor / sed backups
*.bak

# Ad hoc Playwright verification screenshots — debug output, not a deliverable
.playwright-shots/

# macOS menubar app (Swift) — generated artifacts
menubar/build/
menubar/ai-pulse.xcodeproj/
menubar/**/*.xcuserstate
menubar/**/xcuserdata/
menubar/**/.swiftpm/
