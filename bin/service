#!/usr/bin/env bash
# Manage the telemetrify LaunchAgent on macOS.
# Subcommands: install | uninstall | start | stop | restart | status | logs
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LABEL="com.amastropaolo.telemetrify"
PLIST_SRC="$ROOT/deploy/$LABEL.plist"
PLIST_DEST="$HOME/Library/LaunchAgents/$LABEL.plist"

# Companion agent: Rocco replication (bin/rocco-sync tick, every 5 min).
ROCCO_LABEL="com.amastropaolo.telemetrify-rocco-sync"
ROCCO_SRC="$ROOT/deploy/$ROCCO_LABEL.plist"
ROCCO_DEST="$HOME/Library/LaunchAgents/$ROCCO_LABEL.plist"

# Companion agent: daily digest (bin/digest --notify at 22:00).
DIGEST_LABEL="com.amastropaolo.telemetrify-digest"
DIGEST_SRC="$ROOT/deploy/$DIGEST_LABEL.plist"
DIGEST_DEST="$HOME/Library/LaunchAgents/$DIGEST_LABEL.plist"

# Install/uninstall any companion agent by label+src+dest.
_install_agent() {
  local label="$1" src="$2" dest="$3"
  if [[ ! -f "$src" ]]; then echo "missing: $src" >&2; return 1; fi
  mkdir -p "$HOME/Library/LaunchAgents"
  cp "$src" "$dest"
  launchctl unload "$dest" 2>/dev/null || true
  launchctl load -w "$dest"
  echo "installed and loaded: $label"
  launchctl list | grep "$label" || true
}
_uninstall_agent() {
  local label="$1" dest="$2"
  launchctl unload "$dest" 2>/dev/null || true
  rm -f "$dest"
  echo "uninstalled: $label"
}

# The launchd plist is the actual source of truth for the port the running
# UI listens on (it's hardcoded in ProgramArguments' --port there, not read
# from any env var this script sets). Read it from there instead of
# hardcoding it a second time, so a port change in the plist can't silently
# desync this script's health check. Prefers the installed plist (what's
# actually loaded); falls back to the repo's source plist if not installed
# yet, then to 8767 if neither is parseable.
_service_port() {
  local plist="$PLIST_DEST"
  [[ -f "$plist" ]] || plist="$PLIST_SRC"
  local port=""
  if [[ -f "$plist" ]]; then
    port="$(/usr/libexec/PlistBuddy -c "Print :ProgramArguments" "$plist" 2>/dev/null \
      | sed 's/^[[:space:]]*//' | awk '/^--port$/{getline; print; exit}')"
  fi
  echo "${port:-8767}"
}

cmd="${1:-status}"

case "$cmd" in
  install)
    _install_agent "$LABEL" "$PLIST_SRC" "$PLIST_DEST"
    ;;

  uninstall)
    _uninstall_agent "$LABEL" "$PLIST_DEST"
    ;;

  install-rocco-sync)
    _install_agent "$ROCCO_LABEL" "$ROCCO_SRC" "$ROCCO_DEST"
    ;;

  uninstall-rocco-sync)
    _uninstall_agent "$ROCCO_LABEL" "$ROCCO_DEST"
    ;;

  install-digest)
    _install_agent "$DIGEST_LABEL" "$DIGEST_SRC" "$DIGEST_DEST"
    ;;

  uninstall-digest)
    _uninstall_agent "$DIGEST_LABEL" "$DIGEST_DEST"
    ;;

  start)
    launchctl start "$LABEL"
    echo "started: $LABEL"
    ;;

  stop)
    launchctl stop "$LABEL"
    echo "stopped: $LABEL"
    ;;

  restart)
    launchctl stop "$LABEL" 2>/dev/null || true
    sleep 1
    launchctl start "$LABEL"
    echo "restarted: $LABEL"
    ;;

  status)
    port="$(_service_port)"
    echo "label:    $LABEL"
    echo "plist:    $PLIST_DEST"
    if launchctl list | grep -q "$LABEL"; then
      launchctl list | grep "$LABEL"
      echo "loaded:   yes"
    else
      echo "loaded:   no"
    fi
    if curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${port}/" 2>/dev/null | grep -q 200; then
      echo "health:   UI responding on http://127.0.0.1:${port}"
    else
      echo "health:   UI NOT responding on ${port}"
    fi
    echo
    echo "rocco-sync agent: $ROCCO_LABEL"
    if launchctl list | grep -q "$ROCCO_LABEL"; then
      launchctl list | grep "$ROCCO_LABEL"
      echo "loaded:   yes"
    else
      echo "loaded:   no  (install with: $(basename "$0") install-rocco-sync)"
    fi
    ;;

  logs)
    echo "--- stdout (tail) ---"
    tail -n 30 "$ROOT/data/ui-stdout.log" 2>/dev/null || echo "(none)"
    echo
    echo "--- stderr (tail) ---"
    tail -n 30 "$ROOT/data/ui-stderr.log" 2>/dev/null || echo "(none)"
    ;;

  *)
    echo "usage: $(basename "$0") {install|uninstall|start|stop|restart|status|logs|install-rocco-sync|uninstall-rocco-sync|install-digest|uninstall-digest}"
    exit 2
    ;;
esac
