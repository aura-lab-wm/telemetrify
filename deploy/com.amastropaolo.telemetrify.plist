<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS LaunchAgent for telemetrify UI.

  Install:
      cp deploy/com.amastropaolo.telemetrify.plist ~/Library/LaunchAgents/
      launchctl load -w ~/Library/LaunchAgents/com.amastropaolo.telemetrify.plist

  Or use the helper:
      bin/service install      # copy + load
      bin/service status       # query
      bin/service restart      # bounce
      bin/service uninstall    # unload + remove
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.amastropaolo.telemetrify</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/amastro/Projects/telemetrify/.venv/bin/python</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>telemetrify.ui.app:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8767</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/amastro/Projects/telemetrify</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>

    <!--
      /ask routing — PLANNER ONLY. The planner needs strict JSON, which the
      Mac-local Ollama tier can't be trusted to produce ("planner failed: AI
      response not JSON"). It prefers Rocco (free 72B when the GPU box is up),
      then the headless `claude -p` tier (reliable JSON via the logged-in
      Claude Code subscription — no API key, survives an empty ANTHROPIC_*
      launchd env), then Anthropic as a last resort.

      Note this is the PLANNER's order only (qa._planner_order). The
      SYNTHESIZER (same feature="qa") returns free-form Markdown, so it stays
      on the fast default order (rocco,localmac,ollama,anthropic) and keeps
      using the cheap local tier — no 30s-per-call claude CLI overhead.
    -->
    <key>TELEMETRIFY_LLM_ORDER__qa_planner</key>
    <string>rocco,claude_cli,anthropic</string>

    <!-- Real binary, not the zsh shell-function wrapper. -->
    <key>CLAUDE_CLI_BIN</key>
    <string>/opt/homebrew/bin/claude</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/amastro/Projects/telemetrify/data/ui-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/amastro/Projects/telemetrify/data/ui-stderr.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>Nice</key>
  <integer>5</integer>
</dict>
</plist>
